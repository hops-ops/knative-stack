# code: language=yaml
#
# Initialize $state with spec defaults
#

{{- $xr := getCompositeResource . }}
{{- $spec := $xr.spec | default dict }}
{{- $metadata := $xr.metadata | default dict }}

# ==============================================================================
# Core defaults
# ==============================================================================
{{- $name := $metadata.name | default "knative" }}
{{- $clusterName := $spec.clusterName | default $name }}
{{- $managementPolicies := $spec.managementPolicies | default (list "*") }}
{{- $hostedZone := $spec.hostedZone | default "" }}

# Cert-manager
{{- $certManager := $spec.certManager | default dict }}
{{- $certManagerEnabled := false }}
{{- if hasKey $certManager "enabled" }}
  {{- $certManagerEnabled = $certManager.enabled }}
{{- end }}
{{- $issuerRef := $certManager.issuerRef | default "name: letsencrypt-production\nkind: ClusterIssuer" }}

# Gateway API parent gateway (provisioned by istio-stack or equivalent)
{{- $gwRef := $spec.gatewayRef | default dict }}
{{- $gwRefName := $gwRef.name | default "platform" }}
{{- $gwRefNamespace := $gwRef.namespace | default "istio-ingress" }}
{{- $gwRefClass := $gwRef.gatewayClassName | default "istio" }}

# Auto-TLS (per-namespace wildcard mode)
{{- $autoTls := $spec.autoTls | default dict }}
{{- $autoTlsEnabled := false }}
{{- if hasKey $autoTls "enabled" }}
  {{- $autoTlsEnabled = $autoTls.enabled }}
{{- end }}
{{- $autoTlsSelector := $autoTls.namespaceSelector | default (dict "matchLabels" (dict "knative.dev/auto-tls" "true")) }}

# Labels
{{- $defaultLabels := dict
  "hops.ops.com.ai/managed" "true"
  (printf "hops.ops.com.ai/%s" (lower $xr.kind)) $name
}}
{{- $labels := merge $defaultLabels ($spec.labels | default dict) }}

# Helm provider config (defaults to clusterName)
{{- $helmProviderConfigRef := $spec.helmProviderConfigRef | default dict }}
{{- $helmProviderConfigRef = dict
  "name" ($helmProviderConfigRef.name | default $clusterName)
  "kind" ($helmProviderConfigRef.kind | default "ProviderConfig")
}}

# Kubernetes provider config (defaults to clusterName)
{{- $k8sProviderConfigRef := $spec.kubernetesProviderConfigRef | default dict }}
{{- $k8sProviderConfigRef = dict
  "name" ($k8sProviderConfigRef.name | default $clusterName)
  "kind" ($k8sProviderConfigRef.kind | default "ProviderConfig")
}}

# ==============================================================================
# Per-component defaults
# ==============================================================================
{{- $knOp := $spec.knativeOperator | default dict }}
{{- $knServing := $spec.knativeServing | default dict }}
{{- $knEventing := $spec.knativeEventing | default dict }}
{{- $nats := $spec.nats | default dict }}

# enabled defaults (avoid default() overriding explicit false)
{{- $knServingEnabled := true }}
{{- if hasKey $knServing "enabled" }}
  {{- $knServingEnabled = $knServing.enabled }}
{{- end }}
{{- $knEventingEnabled := true }}
{{- if hasKey $knEventing "enabled" }}
  {{- $knEventingEnabled = $knEventing.enabled }}
{{- end }}
{{- $natsEnabled := true }}
{{- if hasKey $nats "enabled" }}
  {{- $natsEnabled = $nats.enabled }}
{{- end }}

# ==============================================================================
# Knative Serving default spec — net-gateway-api ingress
# ==============================================================================
# config-gateway settings consumed by net-gateway-api. Knative attaches every
# emitted HTTPRoute as a parentRef to the named Gateway. external-gateways
# handles public traffic, local-gateways handles cluster-local routes.
#
# The format is `gateway: <namespace>/<name>` and `service: <namespace>/<svc>`
# (single strings). Istio auto-creates the Service when the Gateway is
# materialized — for a Gateway named "platform" with class "istio", the Service
# is "platform-istio" in the same namespace.
{{- $extGwService := printf "%s/%s-%s" $gwRefNamespace $gwRefName $gwRefClass }}
{{- $extGwRef := printf "%s/%s" $gwRefNamespace $gwRefName }}
{{- $externalGatewaysYaml := printf "- class: %s\n  gateway: %s\n  service: %s\n  supported-features:\n  - HTTPRouteRequestTimeout" $gwRefClass $extGwRef $extGwService }}
# Local Gateway: composed by this stack in the knative-serving namespace as
# "knative-local-gateway" with the same gatewayClassName. Used by Knative for
# cluster-local routes (svc.cluster.local hostnames).
{{- $localGwRef := printf "%s/knative-local-gateway" ($knServing.namespace | default "knative-serving") }}
{{- $localGwService := printf "%s/knative-local-gateway-%s" ($knServing.namespace | default "knative-serving") $gwRefClass }}
{{- $localGatewaysYaml := printf "- class: %s\n  gateway: %s\n  service: %s\n  supported-features:\n  - HTTPRouteRequestTimeout" $gwRefClass $localGwRef $localGwService }}

{{- $servingNetwork := dict
  "ingress-class" "gateway-api.ingress.networking.knative.dev"
}}
{{- if $autoTlsEnabled }}
  {{- $servingNetwork = set $servingNetwork "external-domain-tls" "Enabled" }}
  {{- $servingNetwork = set $servingNetwork "namespace-wildcard-cert-selector" (toJson $autoTlsSelector) }}
{{- end }}

{{- $servingConfig := dict
  "features" (dict
    "kubernetes.podspec-affinity" "enabled"
    "kubernetes.podspec-securitycontext" "enabled"
    "kubernetes.podspec-nodeselector" "enabled"
    "kubernetes.podspec-tolerations" "enabled"
    "kubernetes.podspec-topologyspreadconstraints" "enabled"
  )
  "gc" (dict
    "max-non-active-revisions" "10"
    "min-non-active-revisions" "2"
    "retain-since-create-time" "48h"
    "retain-since-last-active-time" "15h"
  )
  "gateway" (dict
    "external-gateways" $externalGatewaysYaml
    "local-gateways" $localGatewaysYaml
  )
  "network" $servingNetwork
}}
{{- if $certManagerEnabled }}
  {{- $servingConfig = set $servingConfig "certmanager" (dict
    "issuerRef" $issuerRef
  ) }}
{{- end }}
{{- if $hostedZone }}
  {{- $servingConfig = set $servingConfig "domain" (dict $hostedZone "") }}
{{- end }}

{{- $natsKnServingDefaults := dict
  "ingress" (dict
    "istio" (dict "enabled" false)
    "contour" (dict "enabled" false)
    "kourier" (dict "enabled" false)
  )
  "config" $servingConfig
  "additionalManifests" (list
    (dict "URL" "https://github.com/knative-extensions/net-gateway-api/releases/download/knative-v1.21.0/release.yaml")
  )
}}
{{- $servingSpec := merge ($knServing.spec | default dict) $natsKnServingDefaults }}

# ==============================================================================
# NATS StorageClass (composed when nats.storageClass.enabled)
# ==============================================================================
{{- $natsSC := $nats.storageClass | default dict }}
{{- $natsSCEnabled := $natsEnabled }}
{{- if hasKey $natsSC "enabled" }}
  {{- $natsSCEnabled = $natsSC.enabled }}
{{- end }}
{{- $natsSCName := $natsSC.name | default "knative-nats" }}
{{- $natsSCProvisioner := $natsSC.provisioner | default "ebs.csi.eks.amazonaws.com" }}
{{- $natsSCParameters := $natsSC.parameters | default (dict "type" "gp3") }}
{{- $natsSCReclaimPolicy := $natsSC.reclaimPolicy | default "Delete" }}
{{- $natsSCVolumeBindingMode := $natsSC.volumeBindingMode | default "WaitForFirstConsumer" }}

# ==============================================================================
# NATS default Helm values
# ==============================================================================
# When the stack composes its own StorageClass, default the NATS PVC
# storageClassName to it (still overridable via nats.values).
{{- $natsPVCDefaults := dict "size" "10Gi" }}
{{- if $natsSCEnabled }}
  {{- $natsPVCDefaults = set $natsPVCDefaults "storageClassName" $natsSCName }}
{{- end }}
{{- $natsDefaultValues := dict
  "config" (dict
    "cluster" (dict
      "enabled" true
      "replicas" 3
    )
    "jetstream" (dict
      "enabled" true
      "fileStore" (dict
        "pvc" $natsPVCDefaults
      )
    )
  )
}}
{{- $natsValues := mergeOverwrite (deepCopy $natsDefaultValues) ($nats.values | default dict) }}

# ==============================================================================
# Knative Eventing default spec (NATS channel when enabled)
# ==============================================================================
# Note: dropped config.features.istio (sidecar-only). Ambient handles workload
# mTLS at the node level — eventing doesn't need to know about the mesh.
{{- $eventingDefaults := dict
  "config" dict
}}
{{- if $natsEnabled }}
  {{- $natsNs := $nats.namespace | default "nats" }}
  {{- $eventingDefaults = merge $eventingDefaults (dict
    "config" (dict
      "default-ch-webhook" (dict
        "default-ch-config" (printf "clusterDefault:\n  apiVersion: messaging.knative.dev/v1alpha1\n  kind: NatsJetStreamChannel\n  spec:\n    natsUrl: nats://%s.%s.svc.cluster.local:4222" ($nats.name | default "nats") $natsNs)
      )
    )
  ) }}
{{- end }}
{{- $eventingSpec := merge ($knEventing.spec | default dict) $eventingDefaults }}

# ==============================================================================
# Initialize $state
# ==============================================================================
{{- $state := dict
  "name" $name
  "clusterName" $clusterName
  "managementPolicies" $managementPolicies
  "labels" $labels
  "hostedZone" $hostedZone
  "certManager" (dict "enabled" $certManagerEnabled "issuerRef" $issuerRef)
  "gatewayRef" (dict "name" $gwRefName "namespace" $gwRefNamespace "gatewayClassName" $gwRefClass)
  "autoTls" (dict "enabled" $autoTlsEnabled "namespaceSelector" $autoTlsSelector)
  "helmProviderConfigRef" $helmProviderConfigRef
  "kubernetesProviderConfigRef" $k8sProviderConfigRef
  "knativeOperator" (dict
    "name" ($knOp.name | default "knative-operator")
    "namespace" ($knOp.namespace | default "knative-operator")
    "values" ($knOp.values | default dict)
    "overrideAllValues" ($knOp.overrideAllValues | default dict)
  )
  "knativeServing" (dict
    "enabled" $knServingEnabled
    "name" ($knServing.name | default "knative-serving")
    "namespace" ($knServing.namespace | default "knative-serving")
    "spec" $servingSpec
    "overrideAllSpec" ($knServing.overrideAllSpec | default dict)
  )
  "knativeEventing" (dict
    "enabled" $knEventingEnabled
    "name" ($knEventing.name | default "knative-eventing")
    "namespace" ($knEventing.namespace | default "knative-eventing")
    "spec" $eventingSpec
    "overrideAllSpec" ($knEventing.overrideAllSpec | default dict)
  )
  "nats" (dict
    "enabled" $natsEnabled
    "name" ($nats.name | default "nats")
    "namespace" ($nats.namespace | default "nats")
    "values" $natsValues
    "overrideAllValues" ($nats.overrideAllValues | default dict)
    "storageClass" (dict
      "enabled" $natsSCEnabled
      "name" $natsSCName
      "provisioner" $natsSCProvisioner
      "parameters" $natsSCParameters
      "reclaimPolicy" $natsSCReclaimPolicy
      "volumeBindingMode" $natsSCVolumeBindingMode
    )
  )
  "observed" (dict)
  "status" (dict)
}}
